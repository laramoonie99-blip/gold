# ----- Branding (NEXT_PUBLIC_* are embedded into the browser bundle) -----
# App name shown in the header, onboarding title, and <title>. Default: "Scorp".
NEXT_PUBLIC_APP_NAME=Scorp
# Short tagline used in <meta>. Default: "2% APR on every stake".
NEXT_PUBLIC_APP_TAGLINE=2% APR on every stake
# Token symbol used on the balance card and send form. Default: "SCORP".
NEXT_PUBLIC_APP_TOKEN_SYMBOL=SCORP

# ----- Conversion rates (how many tokens 1 unit of each currency buys) -----
# 1 USDT = 10 SCORP
NEXT_PUBLIC_DEPOSIT_RATE_USDT=10
# 1 BTC = 600000 SCORP
NEXT_PUBLIC_DEPOSIT_RATE_BTC=600000
# 1 SOL = 1500 SCORP
NEXT_PUBLIC_DEPOSIT_RATE_SOL=1500

# ----- Deposit addresses (shown in the payment modal when users buy tokens) -----
# USDT (ERC-20) deposit address.
NEXT_PUBLIC_DEPOSIT_ADDRESS_USDT=0x0000000000000000000000000000000000000000
# BTC deposit address.
NEXT_PUBLIC_DEPOSIT_ADDRESS_BTC=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
# SOL deposit address.
NEXT_PUBLIC_DEPOSIT_ADDRESS_SOL=11111111111111111111111111111111

# ----- Server secrets -----
# Secret used to sign anti-bot challenges. Set to a long random string in prod.
BOT_GUARD_SECRET=change-me-to-a-long-random-string

# ----- Telegram notifications -----
# Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Chat ID where notifications are sent. DM the bot, then visit
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates to find your chat ID.
TELEGRAM_CHAT_ID=
